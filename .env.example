# Copy to .env (gitignored) and fill in. Never put real values in this file.

# Postgres — docker-compose.yml reads POSTGRES_PASSWORD from this file
POSTGRES_PASSWORD=""
DATABASE_URL="postgresql://lolpamin:PASSWORD@localhost:5434/lolpamin"
DATABASE_URL_TEST="postgresql://lolpamin:PASSWORD@localhost:5434/lolpamin_test"

# Discord bot (apps/discord-bot) — get these from https://discord.com/developers/applications
DISCORD_APP_ID=""
DISCORD_PUBLIC_KEY=""
DISCORD_TOKEN=""
DISCORD_GUILD_ID=""

# Dashboard
COOKIE_SECURE="true"

# Oracle Cloud deploy target (not read by any code yet — deploy scripts pending)
OCI_INSTANCE_IP=""
OCI_INSTANCE_SSH_PORT="22"
OCI_INSTANCE_SSH_USER=""
OCI_INSTANCE_SSH_KEY_PATH=""
OCI_INSTANCE_SERVICE_PORT=""
