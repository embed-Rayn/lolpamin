# Copy to .env (gitignored) and fill in. Never put real values in this file.

# Postgres — docker-compose.yml reads POSTGRES_PASSWORD from this file
POSTGRES_PASSWORD=""
DATABASE_URL="postgresql://lolpamin:PASSWORD@localhost:5434/lolpamin"
DATABASE_URL_TEST="postgresql://lolpamin:PASSWORD@localhost:5434/lolpamin_test"

# Discord bot (apps/discord-bot) — get these from https://discord.com/developers/applications
DISCORD_APP_ID=""
DISCORD_PUBLIC_KEY=""
DISCORD_TOKEN=""
DISCORD_GUILD_ID=""

# Riot API — https://developer.riotgames.com. 개발 키는 24시간마다 만료된다(매일 갱신).
# 매일 갱신이 귀찮으면 Personal API Key를 신청한다(영구, 같은 한도).
RIOT_API_KEY=""

# 최초 관리자 1회 생성용. Admin 테이블이 비어 있을 때만 동작한다.
# 로그인이 되는 것을 확인한 뒤에는 두 줄을 지운다.
ADMIN_BOOTSTRAP_USERNAME=""
ADMIN_BOOTSTRAP_PASSWORD=""

# HTTPS로 서비스할 때만 "true". 평문 HTTP에서 켜면 쿠키가 전송되지 않아 로그인이 안 된다.
COOKIE_SECURE="false"

# Oracle Cloud deploy target (read by the deploy steps, not by the app)
OCI_INSTANCE_IP=""
OCI_INSTANCE_SSH_PORT="22"
OCI_INSTANCE_SSH_USER=""
OCI_INSTANCE_SSH_KEY_PATH=""
OCI_INSTANCE_SERVICE_PORT=""
