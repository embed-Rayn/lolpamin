generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Team {
  BLUE
  RED
}

// 회원이 주로 서는 라인. 리플레이 TEAM_POSITION(JUNGLE/MIDDLE/BOTTOM/UTILITY)과는
// 표기가 다르다 — 둘을 견줄 일이 생기면 변환표를 둔다.
enum Lane {
  TOP
  JUG
  MID
  AD
  SUP
}

// 솔로랭크 티어. 마스터 위쪽은 티어 이름이 아니라 LP 구간으로 자른다 — 그랜드마스터와
// 챌린저는 별도 티어가 아니라 마스터 LP의 상위 구간이라, LP로 자르면 자동으로 덮인다.
// 선언 순서는 점수 내림차순이다(packages/core/src/tier.ts의 TIER_SCORES와 같은 순서).
// 아이언을 1~4로 쪼개지 않는 것은 전부 0점이라서다.
enum MemberTier {
  MASTER_1000_PLUS
  MASTER_800_1000
  MASTER_600_800
  MASTER_400_600
  MASTER_200_400
  MASTER_0_200
  DIAMOND_1
  DIAMOND_2
  DIAMOND_3
  DIAMOND_4
  EMERALD_1
  EMERALD_2
  EMERALD_3
  EMERALD_4
  PLATINUM_1
  PLATINUM_2
  PLATINUM_3
  PLATINUM_4
  GOLD_1
  GOLD_2
  GOLD_3
  GOLD_4
  SILVER_1
  SILVER_2
  SILVER_3
  SILVER_4
  BRONZE_1
  BRONZE_2
  BRONZE_3
  BRONZE_4
  IRON
  UNRANKED
}

// 분기 리셋의 종류. SOFT는 기준값 쪽으로 절반 수축, HARD는 전원 기준값으로.
enum RatingResetKind {
  SOFT
  HARD
}

// 게임 모드. 협곡과 칼바람은 서로 완전히 독립된 레이팅 트랙이다 — Member.mmr/aramMmr,
// GameResult.mode 참고. 셋 이상으로 늘어나면 그때 모드를 키로 하는 테이블로 일반화한다.
enum GameMode {
  RIFT
  ARAM
}

model Member {
  id                 String   @id @default(uuid())
  realName           String?
  age                Int?
  riotId             String?
  // 「티어를 모른다」와 「언랭이다」는 점수가 0으로 같고 화면 문구도 같다. nullable로
  // 두면 아무것도 얻지 못하면서 null 분기만 늘어난다.
  tier               MemberTier @default(UNRANKED)
  // 회원 정보 페이지의 비고 칸 — 운영자가 손으로 남기는 자유 텍스트 메모.
  note               String?
  // 회원 정보 페이지의 주라인·부라인. 운영자가 손으로 고른다. null은 「아직 모름」.
  mainLane           Lane?
  subLane            Lane?
  discordUserId      String?  @unique
  discordHandle      String?
  discordDisplayName String?
  discordJoinedAt    DateTime?
  kakaoUserId        String?  @unique
  kakaoNickname      String?
  mmr                Int      @default(1000)
  aramMmr            Int      @default(1000)
  lastActiveAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // 흡수된 행(묘비)이 가리키는 생존자. null이면 활성 회원이다.
  // 묘비는 자기 kakaoNickname을 과거 닉네임으로 보존해 임포트 매칭에 쓰인다.
  mergedIntoId String?
  mergedInto   Member?  @relation("MemberMerge", fields: [mergedIntoId], references: [id])
  absorbed     Member[] @relation("MemberMerge")

  mentionLogs  MentionLog[]
  participants GameParticipant[]
  riotAccounts RiotAccount[]

  @@index([mergedIntoId])
}

model GameResult {
  id        String   @id @default(uuid())
  playedAt  DateTime
  winner    Team
  mode      GameMode @default(RIFT)
  createdAt DateTime @default(now())

  // 같은 리플레이의 재업로드를 막는다. 정렬한 PUUID 10개 + gameLength의 SHA-256.
  // 파일명에 의존하지 않으므로 이름을 바꿔 올려도 같은 값이 나온다. 손으로 입력한 경기는 null이다.
  replayKey String? @unique

  // 입력·취소한 운영진. Admin.createdById와 같은 이유로 외래키를 걸지 않는다 — 관리자
  // 계정이 지워져도 「누가 무엇을 했는지」는 남아야 한다.
  createdById   String?
  cancelledAt   DateTime?
  cancelledById String?

  participants GameParticipant[]

  // 되돌리기 대상은 "살아 있는 것 중 가장 나중에 입력된 것"이라 이 순서로 찾는다.
  @@index([cancelledAt, createdAt])
}

model GameParticipant {
  id           String     @id @default(uuid())
  gameResultId String
  gameResult   GameResult @relation(fields: [gameResultId], references: [id])
  memberId     String
  member       Member     @relation(fields: [memberId], references: [id])
  team         Team
  mmrBefore    Int
  mmrAfter     Int

  // 흡수로 이 행을 넘겨받기 전의 원래 주인. releaseMember가 정확히 되돌리는 근거다.
  // 값은 비어 있을 때만 채운다 — 이미 이관된 행이 다시 이관돼도 최초 주인이 남아야 한다.
  absorbedFromId String?

  @@unique([gameResultId, memberId])
  @@index([absorbedFromId])
}

model MentionLog {
  id          String   @id @default(uuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  mentionedAt DateTime
  rawMessage  String?
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  // 이 관리자를 추가한 관리자의 id. FK가 아니다 — 추가한 사람이 삭제돼도
  // "누가 추가했는지"는 남아야 하고, 화면에서는 조회 실패 시 "삭제된 관리자"로 표시한다.
  createdById  String?

  sessions AdminSession[]
}

model AdminSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// 실행된 리셋 한 번. 가장 최근 행의 resetAt이 전적 집계의 기준선이 된다 — 판/승/패는
// 저장된 값이 아니라 GameParticipant를 세어 만드므로, 「전적 0/0/0」은 참가 기록을
// 지우는 대신 이 기준선 이후에 입력된 경기만 세는 것으로 만든다. 경기 기록은 그대로 남는다.
model RatingReset {
  id          String          @id @default(uuid())
  kind        RatingResetKind
  resetAt     DateTime        @default(now())
  // 리셋이 건드린 활성 회원 수. 실행 결과를 나중에 확인할 수 있게 남긴다.
  memberCount Int

  // 실행한 관리자. Admin.createdById와 같은 이유로 외래키를 걸지 않는다.
  createdById String?

  @@index([resetAt])
}

// MMR 계산식의 조정 가능한 부분. 행은 하나뿐이고 id는 SINGLETON_ID로 고정된다 —
// 설정에 이력이 필요 없고, 여러 행이 생기면 "어느 것이 진짜인지" 문제가 생긴다.
model MmrSetting {
  id        String   @id
  k         Int      @default(40)
  winPoint  Int      @default(3)
  lossPoint Int      @default(1)
  updatedAt DateTime @updatedAt
  // 마지막으로 바꾼 운영진. Admin.createdById와 같은 이유로 외래키를 걸지 않는다.
  updatedById String?
}

// 검증된 PUUID로만 만드는 라이엇 계정. 한 회원이 부계정을 여러 개 가질 수 있으므로 Member 1:N이다.
//
// 소스는 둘뿐이다 — 리플레이 메타데이터, Riot Account-V1 응답. 둘 다 라이엇이 준 PUUID다.
// 카톡·디코 닉네임과 Member.riotId에 적힌 "게임닉#태그"로는 절대 만들지 않는다 — 그 값들은
// 사람이 손으로 적은 것이라 오타·태그 누락이 흔하고, 그대로 저장하면 박병준#0216(리플레이)과
// 박병준#kr1(카톡 오기)이 별개 계정이 되어 중복이 늘어난다. 그 문자열은 조회의 입력일 뿐이고,
// 행은 조회가 PUUID를 돌려줬을 때만 생긴다.
model RiotAccount {
  id String @id @default(uuid())

  // null이면 "회원 아님"으로 확정한 외부인 계정. 다음 업로드에서 다시 묻지 않으려고 남긴다.
  // 회원을 지울 때 이 행을 조용히 memberId=null로 만들면 "외부인으로 확정"과 구별되지
  // 않는다. 그래서 막고, deleteMember가 명시적으로 지운다.
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Restrict)

  // 리플레이에서만 얻는다. 인게임 닉을 바꿔도 변하지 않는 유일한 값이라 이 테이블의 정체성이다.
  puuid String @unique

  // 마지막으로 관측된 표기. 닉변하면 갱신한다. 화면 표시용이며 매칭의 근거가 아니다.
  gameName String
  tagLine  String

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime

  // GameParticipant.absorbedFromId와 같은 규칙. 흡수로 넘어오기 전의 원래 주인이다.
  absorbedFromId String?

  @@index([memberId])
  @@index([absorbedFromId])
}

// 사이트 전체에 적용되는 스킨 등 운영 설정. 한 행(id = "default")만 쓴다 — MmrSetting과
// 같은 싱글턴 패턴. 스킨은 관리자가 /admins에서 고르고 모든 방문자에게 같은 것이 보인다.
model SiteSetting {
  id          String   @id
  theme       String   @default("clean")
  // 로고·홈 배너. 전부 null 허용 — null이면 기본값(게임패드 아이콘, "롤파민",
  // "함께라서 더 즐거운 게임", public/banner.png)을 쓴다. lib/queries/branding.ts가
  // 이 기본값 적용을 맡는다.
  logoSvg               String?
  siteName              String?
  siteTagline           String?
  homeBannerDesktop     Bytes?
  homeBannerDesktopType String?
  homeBannerMobile      Bytes?
  homeBannerMobileType  String?
  // PUUID로 Riot ID를 되읽은 마지막 시각. 그 배치를 하루 한 번으로 묶는 근거다 —
  // 브라우저가 아니라 여기 있어야 관리자가 여럿이어도 같은 한도를 본다.
  riotIdRefreshedAt DateTime?
  updatedAt   DateTime @updatedAt
  updatedById String?
}
